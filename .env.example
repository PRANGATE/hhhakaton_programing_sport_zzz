NODE_ENV=production
PORT=3000
NODE_OPTIONS=--max-old-space-size=192

DATABASE_URL=postgres://fsp:fsp_secret@localhost:5432/fsp

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

KEYCLOAK_ENABLED=false
KEYCLOAK_URL=https://id.fsp.example
KEYCLOAK_REALM=fsp
KEYCLOAK_CLIENT_ID=fsp-web