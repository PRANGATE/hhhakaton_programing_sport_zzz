NODE_ENV=production
PORT=3000
NODE_OPTIONS=--max-old-space-size=192

DATABASE_URL=postgres://fsp:fsp_secret@localhost:5432/fsp

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

KEYCLOAK_ENABLED=false
KEYCLOAK_URL=https://id.fsp.example
KEYCLOAK_REALM=fsp
KEYCLOAK_CLIENT_ID=fsp-web

# ---------- LLM ----------
# Куда ходить за LLM. Для локального запуска — Ollama на хосте,
# в Docker — на host.docker.internal, в compose — на ollama-tunnel:11434.
OLLAMA_URL=http://host.docker.internal:11434

# generate — только LLM (503 при недоступности),
# pool     — только пул из БД,
# hybrid   — LLM, при недоступности — пул (по умолчанию).
LLM_MODE=hybrid

# auto | ollama | yandex | giga | openai | mock
LLM_PROVIDER=auto

LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=0.7
LLM_JSON_RETRIES=1

# ---------- Туннель Ollama ----------
# Секрет, общий для VPS (tunnel/server.js) и домашнего ПК (tunnel/client.js).
# На VPS пишется в контейнер как TUNNEL_SECRET, локально читается скриптом
# scripts/start-tunnel.*. В проде НЕ должен совпадать с JWT-секретами.
TUNNEL_SECRET=change_me_shared_tunnel_secret

# Опционально — URL VPS-туннеля для клиента. Если не задан,
# scripts/start-tunnel.ps1 собирает его из VpsHost и порта 4010.
# VPS_TUNNEL_URL=ws://31.185.105.155:4010/ollama-tunnel